<?xml version="1.0"?>
<ruleset name="WooCompat Auditor">
	<description>WordPress coding standards for WooCompat Auditor.</description>
	<file>woocompat-auditor.php</file>
	<file>src</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
</ruleset>
