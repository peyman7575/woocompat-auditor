{
  "name": "peyman7575/woocompat-auditor",
  "description": "Developer-focused compatibility and production-readiness auditor for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/peyman7575/woocompat-auditor",
  "keywords": [
    "wordpress",
    "woocommerce",
    "compatibility",
    "hpos",
    "diagnostics"
  ],
  "support": {
    "issues": "https://github.com/peyman7575/woocompat-auditor/issues",
    "source": "https://github.com/peyman7575/woocompat-auditor"
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6.20",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit --configuration phpunit.xml.dist",
    "verify-version": "@php scripts/check-version.php",
    "check": [
      "@lint",
      "@test",
      "@verify-version"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
